{
  "name": "job-answer-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Private prototype Chrome extension that drafts one reviewed answer for one selected job-application question.",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "build": "wxt build",
    "test:e2e": "wxt build && playwright test",
    "go:fmt": "cd helper && test -z \"$(gofmt -l .)\"",
    "go:vet": "cd helper && go vet ./...",
    "go:test": "cd helper && go test ./...",
    "helper:build": "cd helper && go build -o bin/host ./cmd/host && go build -o bin/installer ./cmd/installer",
    "helper:dev-install": "npm run helper:build && ./helper/bin/installer dev-install --host-binary helper/bin/host --template installer/templates/native-host.json.tmpl",
    "helper:dev-uninstall": "npm run helper:build && ./helper/bin/installer dev-uninstall",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run go:fmt && npm run go:vet && npm run go:test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
